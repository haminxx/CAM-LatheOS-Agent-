# ---------- CAM Cloud Proxy ----------
ENV=dev
LOG_LEVEL=INFO

# Vendor credentials (NEVER commit real values)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
CARTESIA_API_KEY=

# Model selection
LLM_PROVIDER=groq              # groq | xai
GROQ_MODEL=llama-3.1-70b-versatile
XAI_MODEL=grok-2-latest
CARTESIA_VOICE_ID=
DEEPGRAM_MODEL=nova-2

# AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE=CAM_HardwareTokens

# Server
HOST=0.0.0.0
PORT=8080

# Auth
ALLOW_UNVERIFIED_TOKENS=false  # dev-only escape hatch
